# Public values are compiled into the static export; rebuild when they change.
# Never put DATABASE_URL, service-role keys or passwords here: the browser
# talks only to FastAPI (data) and Supabase Auth (sign-in).
#
# LOCAL:  NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# PILOT:  NEXT_PUBLIC_API_URL=https://<pilot-api-domain>/api/v1
#         (set in the shell or the host's build environment, then npm run build)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key only. API tables are not reachable with it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_BUSINESS_ID=11111111-1111-1111-1111-111111111111
# NEXT_PUBLIC_LOCATION_ID=22222222-2222-2222-2222-222222222222
# NEXT_PUBLIC_TERMINAL_ID=33333333-3333-3333-3333-333333333333
# NEXT_PUBLIC_BUSINESS_NAME=Adonai Pork
# NEXT_PUBLIC_LOCATION_NAME=Dansoman
# NEXT_PUBLIC_TERMINAL_NAME=AD-01
# NEXT_PUBLIC_BRAND_MARK=AP
# NEXT_PUBLIC_FEATURE_CUSTOMER_WEB_ORDERING=false
# NEXT_PUBLIC_FEATURE_KITCHEN_DISPLAY=false
# NEXT_PUBLIC_FEATURE_INVENTORY=false
# NEXT_PUBLIC_FEATURE_RECIPES=false
# NEXT_PUBLIC_FEATURE_DELIVERY=false
# NEXT_PUBLIC_FEATURE_QR_ORDERING=false

# Set true only for a deployment that has the isolated demo accounts provisioned.
NEXT_PUBLIC_DEMO_ACCOUNTS_ENABLED=false
