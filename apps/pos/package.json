{
  "name": "@food-vendor-os/pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 5173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/check-deploy-env.mjs && next build && node scripts/build-sw.mjs",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "tsx --test src/services/*.test.ts",
    "test:e2e": "playwright test",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "idb": "8.0.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "6.2.5",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
