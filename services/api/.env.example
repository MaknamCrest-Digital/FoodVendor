# Variable names only. Never commit real values.
#
# LOCAL (default): .env / .env.local, SQLite, ENVIRONMENT=development.
# TEST/PILOT:      copy to .env.pilot and run with MAKNAM_ENV_FILE=.env.pilot.
# VERCEL:          see docs/DEPLOY_VERCEL.md (transaction pooler, port 6543).
# PRODUCTION:      set these in the hosting provider's secret manager.

# development | test | pilot | production. Development refuses Supabase URLs.
ENVIRONMENT=development
# Local:  sqlite:///./maknam_local.db
# Pilot:  Supabase SESSION pooler (IPv4), e.g.
#         postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#         URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
DATABASE_URL=sqlite:///./maknam_local.db

# Optional pool tuning (PostgreSQL only).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10
# DB_SSLMODE=require

# Exact frontend origins: comma-separated or JSON array. No "*" in pilot/production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,capacitor://localhost

# Supabase Auth project URL; FastAPI verifies access tokens against its JWKS.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Server-side only (never in the frontend). Used once by seed commands to
# create login identities in Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=

# Pilot seed (python -m app.seed_pilot). Leave passwords blank to generate.
PILOT_ADMIN_EMAIL=admin@adonai.test
PILOT_ADMIN_PASSWORD=
PILOT_CASHIER_EMAIL=cashier@adonai.test
PILOT_CASHIER_PASSWORD=

DEMO_SEED_ENABLED=false
